[Unit]
Description=Panacea desktop shell
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=PANACEA_SERVICE_PROCESS=1
Environment=QT_PLUGIN_PATH=/run/current-system/sw/lib/qt-6/plugins
ExecStart=%h/.config/panacea/scripts/start.sh
Restart=always
RestartSec=2
TimeoutStopSec=10
