{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Panel styling: labels in the theme accent, values in white, separators
  // dimmed. The accent line is rewritten by
  // hypr/scripts/switch_theme.sh -- leave the marker below alone.
  "logo": {
    "source": "nixos_small",
    "padding": { "top": 3, "left": 3, "right": 4 },
    // panacea:accent
    "color": { "1": "31", "2": "32" }
  },

  "display": {
    "separator": "  ",
    "color": {
      // panacea:accent
      "keys": "36",
      "title": "white",
      "output": "white"
    }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    { "type": "separator", "string": "─" },

    // what makes this machine this machine
    { "type": "custom", "key": "󰏔 Shell   ", "keyColor": "red",     "format": "Panacea Island" },
    { "type": "wm",       "key": "󱂬 WM      ", "keyColor": "green" },
    { "type": "os",       "key": "\uf313 OS      ", "keyColor": "yellow", "format": "{name} {arch}" },
    { "type": "kernel",   "key": "󰒋 Kernel  ", "keyColor": "blue",   "format": "{release}" },
    { "type": "uptime",   "key": "󱎫 Uptime  ", "keyColor": "magenta" },
    { "type": "packages", "key": "󰏗 Packages", "keyColor": "cyan",   "format": "{all}" },

    "break",

    { "type": "terminal", "key": "󰆍 Terminal", "keyColor": "white", "format": "{pretty-name}" },
    { "type": "shell",    "key": "󰈺 CLI     ", "keyColor": "red",    "format": "{pretty-name} {version}" },
    {
      "type": "command",
      "key": "󰻠 CPU     ",
      "keyColor": "green",
      "text": "cpu=$(fastfetch -s cpu --format json 2>/dev/null | jq -r '.[0].result.cpu'); printf '%s' \"$cpu\" | fold -s -w 35",
      "splitLines": true
    },
    {
      "type": "command",
      "key": "󰢮 GPU     ",
      "keyColor": "yellow",
      "text": "gpu=$(fastfetch -s gpu --format json 2>/dev/null | jq -r '.[0].result[0].name'); printf '%s' \"$gpu\" | fold -s -w 35",
      "splitLines": true
    },
    { "type": "memory",   "key": "󰍛 Memory  ", "keyColor": "blue" },
    { "type": "disk",     "key": "󰋊 Disk    ", "keyColor": "magenta", "folders": "/" },
    { "type": "battery",  "key": "󰁹 Battery ", "keyColor": "cyan",   "format": "{capacity} ({status})" },

    "break",
    { "type": "separator", "string": "─" },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    },
    "break"
  ]
}
